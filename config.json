{
  "project": {
    "name": "医学影像分割与弱监督学习文献日报",
    "timezone": "Asia/Shanghai"
  },
  "window": {
    "days": 3,
    "max_catchup_days": 30,
    "max_items_per_journal": 60,
    "workers": 6,
    "rss_timeout_seconds": 25,
    "api_timeout_seconds": 45,
    "retries": 2,
    "sources": {
      "rss": false,
      "openalex": true,
      "crossref": true
    }
  },
  "output": {
    "dir": "reports",
    "keep_days": 365,
    "max_entries": 10,
    "open_after_run": false,
    "write_json_snapshot": true,
    "source_status": "summary",
    "frontmatter": true
  },
  "keywords": [
    {
      "label": "医学影像分割",
      "weight": 4,
      "terms": [
        "medical image segmentation",
        "medical imaging segmentation",
        "medical segmentation",
        "biomedical image segmentation",
        "organ segmentation",
        "tumor segmentation",
        "tumour segmentation",
        "lesion segmentation",
        "brain segmentation",
        "cardiac segmentation",
        "liver segmentation",
        "lung segmentation",
        "prostate segmentation",
        "nuclei segmentation",
        "cell segmentation",
        "vessel segmentation",
        "retinal segmentation",
        "polyp segmentation",
        "volumetric segmentation",
        "3d segmentation",
        "multi-organ segmentation",
        "anatomical segmentation"
      ]
    },
    {
      "label": "弱监督学习",
      "weight": 4,
      "terms": [
        "weakly supervised",
        "weakly-supervised",
        "weak supervision",
        "weak supervision learning",
        "weakly annotated",
        "weak annotation",
        "partially supervised",
        "partial supervision",
        "sparsely annotated",
        "sparse annotation",
        "scribble supervision",
        "scribble-supervised",
        "scribble annotation",
        "point supervision",
        "point-supervised",
        "box supervision",
        "box-supervised",
        "bounding box annotation",
        "image-level supervision",
        "image level supervision",
        "multiple instance learning",
        "multiple-instance learning"
      ]
    },
    {
      "label": "半监督与标注效率",
      "weight": 2,
      "terms": [
        "semi-supervised",
        "semi supervised",
        "semi-supervision",
        "annotation-efficient",
        "label-efficient",
        "annotation efficient",
        "label efficient",
        "limited annotation",
        "few-shot segmentation",
        "pseudo-label",
        "pseudo label",
        "pseudo-labeling",
        "pseudo-labelling"
      ]
    },
    {
      "label": "通用分割方法",
      "weight": 1,
      "terms": [
        "segmentation",
        "segmenting"
      ]
    }
  ],
  "exclude_terms": [
    "retraction",
    "retracted",
    "correction",
    "corrigendum",
    "erratum",
    "author correction",
    "publisher correction",
    "editorial board",
    "in this issue",
    "issue information",
    "table of contents",
    "call for papers"
  ],
  "exclude_doi_prefixes": [
    "10.1038/d41586"
  ],
  "tiers": {
    "must_read": 12,
    "worth_reading": 6,
    "min_score": 3
  },
  "journals": [
    {
      "name": "Medical Image Analysis",
      "issn": "1361-8415",
      "rss": "",
      "enabled": true
    },
    {
      "name": "IEEE Transactions on Medical Imaging",
      "issn": "0278-0062",
      "rss": "",
      "enabled": true
    },
    {
      "name": "Computerized Medical Imaging and Graphics",
      "issn": "0895-6111",
      "rss": "",
      "enabled": true
    },
    {
      "name": "Pattern Recognition",
      "issn": "0031-3203",
      "rss": "",
      "enabled": true
    },
    {
      "name": "IEEE Journal of Biomedical and Health Informatics",
      "issn": "2168-2194",
      "rss": "",
      "enabled": true
    },
    {
      "name": "IEEE Transactions on Biomedical Engineering",
      "issn": "0018-9294",
      "rss": "",
      "enabled": true
    },
    {
      "name": "IEEE Transactions on Pattern Analysis and Machine Intelligence",
      "issn": "0162-8828",
      "rss": "",
      "enabled": true
    },
    {
      "name": "International Journal of Computer Vision",
      "issn": "0920-5691",
      "rss": "",
      "enabled": true
    }
  ],
  "push": {
    "enabled": true,
    "skip_when_empty": true,
    "max_items": 6,
    "max_chars": 1800,
    "channels": {
      "serverchan": {
        "enabled": true,
        "sendkey": ""
      },
      "pushplus": {
        "enabled": false,
        "token": ""
      },
      "bark": {
        "enabled": false,
        "key": "",
        "server": "https://api.day.app",
        "sound": "bird"
      }
    }
  },
  "log": {
    "dir": "logs",
    "level": "INFO"
  }
}
